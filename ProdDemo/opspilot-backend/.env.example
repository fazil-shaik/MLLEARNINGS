# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model tiers -> OpenRouter model slugs (swap freely)
MODEL_FAST=meta-llama/llama-3.1-8b-instruct
MODEL_BALANCED=openai/gpt-4o-mini
MODEL_POWERFUL=anthropic/claude-3.5-sonnet

# ---- NeonDB (Postgres) ----
# Pooled connection = normal app traffic (get from Neon dashboard "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/opspilot?sslmode=require
# Unpooled/direct = required for LangGraph's Postgres checkpointer
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/opspilot?sslmode=require

# ---- Web search tool (real-time info) ----
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

APP_ENV=development
